#!/bin/zsh
# banksec — 은행 보안 프로그램 켜기/끄기/삭제 (자동 감지)
#
#   banksec status                 제품별 상태
#   banksec off [제품...]           끄기 (제품을 안 고르면 전부)
#   banksec on  [제품...]           켜기 (제품을 안 고르면 전부)
#   banksec remove [-n|-y] 제품...  삭제 (-n: 계획만 보기, -y: 확인 없이)
#   banksec list                   감지된 서비스와 감지 근거
#
# off: launchctl disable(재부팅 후에도 유지) + bootout(즉시 종료)
# on : launchctl enable + bootstrap(즉시 실행)
#
# 대상은 보안업체 키워드로 자동 감지한다. 네 군데를 합친다:
#   1) 설치 패키지 기록(pkgutil)에서 보안 패키지가 설치한 plist (label 에 업체명이 없어도 잡힘)
#   2) /Library/LaunchDaemons, /Library/LaunchAgents, ~/Library/LaunchAgents 의 plist
#   3) launchctl 에 지금 로드된 서비스
#   4) launchctl 에 disable 로 기록된 서비스 (꺼둔 뒤 plist 가 사라져도 다시 켤 수 있게)
#
# 새 업체 추가:  ~/.config/banksec/keywords  (한 줄에 하나)
# 제품 이름 추가: ~/.config/banksec/products  ("표시 이름:정규식" 한 줄에 하나)
# 감지 제외:     ~/.config/banksec/exclude   (label 한 줄에 하나)

setopt extended_glob null_glob

# root로 실행될 때(메뉴바 앱) 실제 사용자 UID를 쓰도록
UID_NUM=${BANKSEC_UID:-${SUDO_UID:-$(id -u)}}
USER_HOME=$(dscl . -read /Users/$(id -un $UID_NUM) NFSHomeDirectory 2>/dev/null | awk '{print $2}')
USER_HOME=${USER_HOME:-$HOME}
CONFIG_DIR=$USER_HOME/.config/banksec
CACHE_FILE=$USER_HOME/.cache/banksec/receipts
REMOVED_FILE=$USER_HOME/.local/state/banksec/removed   # remove 로 지운 서비스 label

conf_lines() { [[ -f $CONFIG_DIR/$1 ]] && grep -vE '^\s*(#|$)' $CONFIG_DIR/$1 }

# 국내 은행/공공 보안 프로그램 업체·제품 키워드 (소문자)
KEYWORDS=(
  ahnlab astx interezen ipinside nprotect softforum anysign xecure
  raon touchen keysharp wizvera delfino veraport iniline crossex
  initech inisafe kingsinfo kica signkorea yessign crosscert
  markany dreamsecurity magicline ksign nshc everspin unisign softcamp
)
KEYWORDS+=(${(f)"$(conf_lines keywords | tr 'A-Z' 'a-z')"})
EXCLUDE=(${(f)"$(conf_lines exclude)"})
REMOVED=(${(f)"$([[ -f $REMOVED_FILE ]] && cat $REMOVED_FILE)"})
KW_RE="(${(j:|:)KEYWORDS})"

# 서비스를 제품 단위로 묶는 규칙 ("표시 이름:정규식", 위에서부터 먼저 맞는 것)
PRODUCTS=(
  ${(f)"$(conf_lines products)"}
  "AhnLab Safe Transaction:ahnlab|astx"
  "IPinside:interezen|ipinside"
  "nProtect Online Security:nprotect"
  "AnySign:anysign"
  "XecureWeb:xecure"
  "KeySharp:keysharp"
  "TouchEn nxKey:touchen|raon"
  "Veraport:veraport"
  "Delfino:wizvera|delfino"
  "CrossEX:iniline|crossex"
  "INISAFE CrossWeb EX:initech|inisafe"
  "MarkAny ePageSAFER:markany"
  "MagicLine:magicline|dreamsecurity"
  "SoftForum:softforum"
)

typeset -A DOMAIN PLIST PROGRAM PRODUCT   # label -> system|gui, plist, 실행 파일, 제품 이름
typeset -A PKG_PRODUCT PKG_PROBE           # 설치 패키지 -> 제품 이름, 설치 여부 확인용 파일
DISABLED_SYS=$(launchctl print-disabled system 2>/dev/null)
DISABLED_GUI=$(launchctl print-disabled gui/$UID_NUM 2>/dev/null)
SERVICES_SYS=$(launchctl print system 2>/dev/null | sed -n '/^	services = {/,/^	}/p')
SERVICES_GUI=$(launchctl print gui/$UID_NUM 2>/dev/null | sed -n '/^	services = {/,/^	}/p')

add_job() {  # label domain [plist]
  local label=$1
  [[ -z $label || $label == com.apple.* ]] && return
  (( ${EXCLUDE[(Ie)$label]} )) && return
  # remove 로 지운 서비스는 plist 가 다시 생기기 전(재설치 전)까지 무시
  [[ -z $3 ]] && (( ${REMOVED[(Ie)$label]} )) && return
  [[ ${label:l} =~ $KW_RE || -n $3 ]] || return
  [[ -z ${DOMAIN[$label]} ]] && DOMAIN[$label]=$2
  [[ -n $3 && -z ${PLIST[$label]} ]] && PLIST[$label]=$3
}

pkg_location() { pkgutil --pkg-info $1 2>/dev/null | sed -n 's/^location: //p' }
pkg_paths() {  # pkg --only-files|--only-dirs → 절대 경로
  local loc=$(pkg_location $1) f
  for f in ${(f)"$(pkgutil --files $1 $2 2>/dev/null)"}; do
    f="/$loc/$f"; print -r -- ${f//\/\/##/\/}
  done
}

# 설치 패키지 기록(pkgutil) 중 키워드에 맞는 패키지 목록과, 그 패키지가 설치한 launchd plist.
# Windows 의 '설치된 프로그램 목록'에 해당. pkgutil 이 느려서
# 패키지 설치/삭제(/var/db/receipts 변경)나 키워드 변경 때만 다시 만든다.
#   pkg<TAB>패키지<TAB>설치 여부 확인용 파일(없으면 -)
#   plist<TAB>패키지<TAB>plist 경로
receipts() {
  if [[ ! -f $CACHE_FILE || /var/db/receipts -nt $CACHE_FILE || $CONFIG_DIR/keywords -nt $CACHE_FILE || $0 -nt $CACHE_FILE ]]; then
    mkdir -p ${CACHE_FILE:h} 2>/dev/null
    local p f probe
    for p in ${(f)"$(pkgutil --pkgs | grep -iE "$KW_RE")"}; do
      probe=-
      for f in ${(f)"$(pkg_paths $p --only-files)"}; do
        [[ $probe == - && $f == (/Applications|/Library)/* && -e $f ]] && probe=$f
        [[ $f == /Library/Launch(Daemons|Agents)/[^/]##.plist ]] && print -r -- "plist	$p	$f"
      done
      print -r -- "pkg	$p	$probe"
    done >| $CACHE_FILE 2>/dev/null
    [[ $EUID -eq 0 ]] && chown -R $UID_NUM ${CACHE_FILE:h} 2>/dev/null
  fi
  cat $CACHE_FILE 2>/dev/null
}

product_name() {  # 소문자 텍스트 → 규칙에 맞는 제품 이름 (없으면 빈 문자열)
  local rule
  for rule in $PRODUCTS; do
    [[ $1 =~ "(${rule#*:})" ]] && { print -r -- ${rule%%:*}; return }
  done
}

discover() {
  local f label kind pkg val
  for kind pkg val in ${(ps:\t:)${(pj:\t:)${(f)"$(receipts)"}}}; do
    if [[ $kind == pkg ]]; then
      PKG_PROBE[$pkg]=$val
    elif [[ -f $val ]]; then
      label=$(plutil -extract Label raw -o - "$val" 2>/dev/null) || continue
      [[ $val == /Library/LaunchDaemons/* ]] && add_job "$label" system "$val" || add_job "$label" gui "$val"
    fi
  done
  for f in /Library/LaunchDaemons/*.plist; do
    grep -qiaE "$KW_RE" "$f" 2>/dev/null || continue
    label=$(plutil -extract Label raw -o - "$f" 2>/dev/null) && add_job "$label" system "$f"
  done
  for f in /Library/LaunchAgents/*.plist $USER_HOME/Library/LaunchAgents/*.plist; do
    grep -qiaE "$KW_RE" "$f" 2>/dev/null || continue
    label=$(plutil -extract Label raw -o - "$f" 2>/dev/null) && add_job "$label" gui "$f"
  done
  for label in ${(f)"$(print -r -- $DISABLED_SYS | sed -nE 's/^[[:space:]]*"([^"]+)" =>.*/\1/p')"}; do add_job "$label" system; done
  for label in ${(f)"$(print -r -- $DISABLED_GUI | sed -nE 's/^[[:space:]]*"([^"]+)" =>.*/\1/p')"}; do add_job "$label" gui; done
  for label in ${(f)"$(print -r -- $SERVICES_SYS | awk 'NF>=3 {print $NF}')"}; do add_job "$label" system; done
  for label in ${(f)"$(print -r -- $SERVICES_GUI | awk 'NF>=3 {print $NF}')"}; do add_job "$label" gui; done

  local name
  for label in ${(k)DOMAIN}; do
    if [[ -f ${PLIST[$label]} ]]; then
      PROGRAM[$label]=$(plutil -extract Program raw -o - "${PLIST[$label]}" 2>/dev/null ||
                        plutil -extract ProgramArguments.0 raw -o - "${PLIST[$label]}" 2>/dev/null)
    fi
    name=$(product_name "${label:l} ${PLIST[$label]:l}")
    PRODUCT[$label]=${name:-$label}   # 규칙에 안 맞으면 label 자체를 제품 이름으로
  done
  for pkg in ${(k)PKG_PROBE}; do
    name=$(product_name "${pkg:l}")
    PKG_PRODUCT[$pkg]=${name:-$pkg}
  done
}

slug() { local s=${1:l}; print -r -- ${s//[^a-z0-9]/} }
product_re() {  # 제품 이름 → 경로/프로세스를 가려낼 정규식
  local rule
  for rule in $PRODUCTS; do [[ ${rule%%:*} == $1 ]] && { print -r -- ${rule#*:}; return }; done
  local s=${1:l}; print -r -- ${s//./\\.}
}
products() { local all=(${(v)PRODUCT} ${(v)PKG_PRODUCT}); print -rl -- ${(ou)all} }

target() { [[ ${DOMAIN[$1]} == system ]] && echo system || echo gui/$UID_NUM }

is_enabled() {
  local src=$([[ ${DOMAIN[$1]} == system ]] && print -r -- $DISABLED_SYS || print -r -- $DISABLED_GUI)
  print -r -- $src | grep -qF "\"$1\" => disabled" && echo no || echo yes
}

is_running() {
  local src=$([[ ${DOMAIN[$1]} == system ]] && print -r -- $SERVICES_SYS || print -r -- $SERVICES_GUI)
  print -r -- $src | awk -v l="$1" '$NF==l && $1+0>0 {f=1} END {exit !f}' && echo yes || echo no
}

# 프로그램이 지워지고 서비스 흔적만 남은 경우: plist 가 없거나, plist 가 가리키는 실행 파일이 없음
is_orphan() {
  [[ ! -f ${PLIST[$1]} ]] && return 0
  [[ -n ${PROGRAM[$1]} && ! -e ${PROGRAM[$1]} ]]
}

# 제품 상태 → P_STATE(on|off|removed|noservice), P_RUNNING, P_TOTAL
product_state() {
  local label pkg live=0 installed=0
  P_TOTAL=0 P_RUNNING=0
  for label in ${(f)"$(labels_of $1)"}; do
    (( P_TOTAL++ ))
    [[ $(is_running $label) == yes ]] && (( P_RUNNING++ ))
    is_orphan $label || (( live++ ))
  done
  for pkg in ${(f)"$(pkgs_of $1)"}; do
    [[ ${PKG_PROBE[$pkg]} != - && -e ${PKG_PROBE[$pkg]} ]] && installed=1
  done
  if (( P_RUNNING )); then P_STATE=on
  elif (( live )); then P_STATE=off
  elif (( P_TOTAL == 0 && installed )); then P_STATE=noservice   # 백그라운드 서비스 없는 프로그램
  else P_STATE=removed
  fi
}

# launchd 밖에서 떠 있는 잔여 프로세스 (경로가 정규식에 맞는 것)
leftover_pids() {  # [정규식]
  ps axo pid=,comm= | awk -v re="${1:-$KW_RE}" 'tolower($0) ~ re && $2 !~ /^\/(System|usr)\// {print $1}'
}

run_root() { if [[ $EUID -eq 0 ]]; then "$@"; else sudo "$@"; fi }

# 인자로 받은 제품 이름들 → SELECTED(제품 이름 배열). 인자가 없으면 전부.
# 제품 이름은 대소문자·공백 무시, 일부만 써도 됨 (예: touchen, ahnlab, nprotect)
select_products() {
  SELECTED=()
  local all=(${(f)"$(products)"})
  (( $# )) || { SELECTED=($all); return }
  local arg p hit
  for arg in "$@"; do
    hit=0
    # 이름이 정확히 같은 제품이 있으면 그것만, 없으면 이름 일부가 맞는 제품 전부
    for p in $all; do
      [[ $(slug $p) == $(slug $arg) ]] && { SELECTED+=($p); hit=1 }
    done
    (( hit )) || for p in $all; do
      [[ $(slug $p) == *$(slug $arg)* ]] && { SELECTED+=($p); hit=1 }
    done
    if (( ! hit )); then
      echo "알 수 없는 제품: $arg" >&2
      echo "감지된 제품: ${(j:, :)all}" >&2
      exit 2
    fi
  done
  SELECTED=(${(u)SELECTED})
}

labels_of() {  # 제품 이름들 → label 목록
  local label
  for label in ${(ko)DOMAIN}; do (( ${@[(Ie)${PRODUCT[$label]}]} )) && print -r -- $label; done
}

pkgs_of() {  # 제품 이름들 → 설치 패키지 목록
  local pkg
  for pkg in ${(ko)PKG_PRODUCT}; do (( ${@[(Ie)${PKG_PRODUCT[$pkg]}]} )) && print -r -- $pkg; done
}

turn_off() {
  select_products "$@"
  [[ $EUID -eq 0 ]] || sudo -v || exit 1
  local label t p re
  for label in ${(f)"$(labels_of $SELECTED)"}; do
    t=$(target $label)
    if [[ $t == system ]]; then
      run_root launchctl disable system/$label
      run_root launchctl bootout system/$label 2>/dev/null
    else
      launchctl disable $t/$label
      launchctl bootout $t/$label 2>/dev/null
    fi
  done
  # 잔여 프로세스: 전부 끌 땐 업체 키워드 전체, 일부만 끌 땐 그 제품 규칙만
  local pids=()
  if (( $# == 0 )); then
    pids=($(leftover_pids))
  else
    for p in $SELECTED; do pids+=($(leftover_pids "($(product_re $p))")); done
  fi
  (( $#pids )) && run_root kill $pids 2>/dev/null
  for p in $SELECTED; do echo "🔒 $p 꺼짐"; done
  echo "재부팅해도 꺼진 상태가 유지됩니다."
}

turn_on() {
  select_products "$@"
  [[ $EUID -eq 0 ]] || sudo -v || exit 1
  local label t plist p
  for label in ${(f)"$(labels_of $SELECTED)"}; do
    is_orphan $label && continue
    t=$(target $label); plist=${PLIST[$label]}
    if [[ $t == system ]]; then
      run_root launchctl enable system/$label
      run_root launchctl bootstrap system "$plist" 2>/dev/null
    else
      launchctl enable $t/$label
      launchctl bootstrap $t "$plist" 2>/dev/null
    fi
  done
  for p in $SELECTED; do
    product_state $p
    case $P_STATE in
      removed)   echo "⚠️  $p 은(는) 삭제된 상태라 켤 수 없어요" ;;
      noservice) echo "ℹ️  $p 은(는) 백그라운드 서비스가 없어요" ;;
      *)         echo "🔓 $p 켜짐" ;;
    esac
  done
  echo "은행 사이트를 새로고침하세요."
}

# ───────────────────────── 삭제 ─────────────────────────
#
# 안전 원칙
#  - 지우는 경로는 /Applications, /Library, ~/Library 아래만 (/Library/Apple 제외)
#  - 다른 (선택하지 않은) 보안 프로그램의 설치 기록·실행 파일과 겹치면 남김
#  - 경로에 업체 키워드가 없는 파일은 설치 기록상 선택한 제품만 소유한 경우에만 지움
#  - 폴더를 통째로 지우는 건 폴더 이름이 제품 규칙에 맞고, 안에 다른 프로그램 것이 없을 때만
#  - 그 밖의 폴더는 비었을 때만 지움 (rmdir), 공용 폴더는 비어도 남김

PROTECTED_DIRS=(
  / /Applications /Library /Users /System /private /usr
  "/Library/Application Support" /Library/LaunchAgents /Library/LaunchDaemons
  /Library/Frameworks "/Library/Internet Plug-Ins" /Library/Extensions /Library/Preferences
  /Library/PrivilegedHelperTools /Library/Logs /Library/Caches /Library/Security
  /Library/Google /Library/Google/Chrome /Library/Google/Chrome/NativeMessagingHosts
  "/Library/Application Support/Mozilla" "/Library/Application Support/Mozilla/NativeMessagingHosts"
  "/Library/Application Support/Google" "/Library/Application Support/Google/Chrome"
  "/Library/Application Support/Google/Chrome/NativeMessagingHosts"
  "/Library/Application Support/Microsoft" "/Library/Application Support/Microsoft/Edge"
  "/Library/Application Support/Microsoft/Edge/NativeMessagingHosts"
  $USER_HOME $USER_HOME/Library "$USER_HOME/Library/Application Support" $USER_HOME/Library/LaunchAgents
)
NATIVE_HOST_DIRS=(
  /Library/Google/Chrome/NativeMessagingHosts
  "/Library/Application Support/Mozilla/NativeMessagingHosts"
  "/Library/Application Support/Google/Chrome/NativeMessagingHosts"
  "/Library/Application Support/Microsoft/Edge/NativeMessagingHosts"
  "$USER_HOME/Library/Application Support/Google/Chrome/NativeMessagingHosts"
  "$USER_HOME/Library/Application Support/Mozilla/NativeMessagingHosts"
  "$USER_HOME/Library/Application Support/Microsoft Edge/NativeMessagingHosts"
  "$USER_HOME/Library/Application Support/Naver/Whale/NativeMessagingHosts"
)
APP_BASES=(/Applications "/Library/Application Support" "$USER_HOME/Library/Application Support" /Library)

deletable() {  # 지워도 되는 위치인가
  local p=$1
  (( ${PROTECTED_DIRS[(Ie)$p]} )) && return 1
  [[ $p == /Library/Apple/* ]] && return 1
  [[ $p == /Applications/* || $p == /Library/* || $p == $USER_HOME/Library/* ]]
}

top_root() {  # 경로 → /Applications/X 처럼 기준 폴더 바로 아래 항목
  local base rest
  for base in $APP_BASES; do
    if [[ $1 == $base/* ]]; then
      rest=${1#$base/}
      print -r -- "$base/${rest%%/*}"
      return
    fi
  done
}

# PLAN_ROOTS / PLAN_FILES / PLAN_DIRS / PLAN_SKIP / PLAN_PKGS / PLAN_LABELS 를 채운다
plan_remove() {
  local sel=("$@") p label pkg f d r base e ok owners
  local -a others=() sel_pkgs=() files=() roots=() cands=()
  typeset -gU PLAN_ROOTS=() PLAN_FILES=() PLAN_DIRS=() PLAN_SKIP=() PLAN_PKGS=() PLAN_LABELS=()
  typeset -A keep=()   # 다른 프로그램 소유 경로

  local sre="(${(j:|:)${(f)"$(for p in $sel; do product_re $p; done)"}})"
  for p in ${(f)"$(products)"}; do (( ${sel[(Ie)$p]} )) || others+=($p); done

  # 다른 보안 프로그램이 쓰는 경로
  for label in ${(f)"$(labels_of $others)"}; do
    [[ -n ${PLIST[$label]} ]] && keep[${PLIST[$label]}]=1
    [[ -n ${PROGRAM[$label]} ]] && keep[${PROGRAM[$label]}]=1
  done
  for pkg in ${(f)"$(pkgs_of $others)"}; do
    for f in ${(f)"$(pkg_paths $pkg --only-files)"} ${(f)"$(pkg_paths $pkg --only-dirs)"}; do keep[$f]=1; done
  done

  PLAN_LABELS=(${(f)"$(labels_of $sel)"})
  sel_pkgs=(${(f)"$(pkgs_of $sel)"})
  PLAN_PKGS=($sel_pkgs)

  # 1) 서비스 plist 2) 설치 기록의 파일·폴더
  for label in $PLAN_LABELS; do
    [[ -n ${PLIST[$label]} && ( -e ${PLIST[$label]} || -L ${PLIST[$label]} ) ]] && files+=(${PLIST[$label]})
  done
  for pkg in $sel_pkgs; do
    for f in ${(f)"$(pkg_paths $pkg --only-files)"}; do [[ -e $f || -L $f ]] && files+=($f); done
    for d in ${(f)"$(pkg_paths $pkg --only-dirs)"}; do [[ -d $d ]] && PLAN_DIRS+=($d); done
  done
  # 3) 브라우저 연결 파일 (Native Messaging Host)
  for d in $NATIVE_HOST_DIRS; do
    for f in $d/*.json; do [[ ${${f:t}:l} =~ $sre ]] && files+=($f); done
  done

  # 4) 통째로 지울 폴더 후보: 실행 파일·설치 파일이 들어 있는 폴더 + 이름이 제품에 맞는 폴더
  for label in $PLAN_LABELS; do [[ -n ${PROGRAM[$label]} ]] && cands+=($(top_root ${PROGRAM[$label]})); done
  for f in $files; do r=$(top_root $f); [[ -n $r ]] && cands+=($r); done
  for base in $APP_BASES; do
    for e in $base/*; do [[ ${${e:t}:l} =~ $sre ]] && cands+=($e); done
  done
  for r in ${(u)cands}; do
    [[ -e $r ]] || continue
    [[ ${${r:t}:l} =~ $sre ]] || continue      # 폴더 이름이 제품에 맞아야
    deletable $r || continue
    ok=1
    for f in ${(k)keep}; do [[ $f == $r || $f == $r/* ]] && { ok=0; break }; done
    (( ok )) && PLAN_ROOTS+=($r)
  done

  # 5) 개별 파일 거르기
  for f in ${(u)files}; do
    for r in $PLAN_ROOTS; do [[ $f == $r/* ]] && continue 2; done
    if (( ${+keep[$f]} )); then PLAN_SKIP+=("$f  (다른 보안 프로그램과 공유)"); continue; fi
    if ! deletable $f; then PLAN_SKIP+=("$f  (시스템 경로)"); continue; fi
    if [[ ! ${f:l} =~ $KW_RE ]]; then
      # 업체 이름이 없는 파일은 설치 기록상 선택한 제품만 소유해야 지운다
      owners=(${(f)"$(pkgutil --file-info $f 2>/dev/null | sed -n 's/^pkgid: //p')"})
      if (( ! $#owners )) || [[ -n ${owners:|sel_pkgs} ]]; then
        PLAN_SKIP+=("$f  (다른 프로그램 소유일 수 있음)"); continue
      fi
    fi
    PLAN_FILES+=($f)
  done

  # 6) 빈 폴더 정리 대상 (비었을 때만 rmdir)
  local -a dirs=()
  for d in $PLAN_DIRS; do
    for r in $PLAN_ROOTS; do [[ $d == $r || $d == $r/* ]] && continue 2; done
    (( ${+keep[$d]} )) && continue
    deletable $d && dirs+=($d)
  done
  for f in $PLAN_FILES $PLAN_ROOTS; do   # 지운 파일이 있던 폴더도 비면 정리 (업체 폴더까지)
    d=${f:h}
    while deletable $d && [[ ${d:l} =~ $KW_RE ]] && (( ! ${+keep[$d]} )); do dirs+=($d); d=${d:h}; done
  done
  PLAN_DIRS=($dirs)
}

show_plan() {
  local f n
  echo "삭제할 프로그램: ${(j:, :)SELECTED}"
  echo
  if (( $#PLAN_ROOTS )); then
    echo "■ 폴더 통째로 삭제 (${#PLAN_ROOTS}개)"
    for f in $PLAN_ROOTS; do echo "    $f"; done
  fi
  if (( $#PLAN_FILES )); then
    echo "■ 파일 삭제 (${#PLAN_FILES}개)"
    n=0
    for f in $PLAN_FILES; do (( ++n > 15 )) && { echo "    … 외 $(( $#PLAN_FILES - 15 ))개"; break }; echo "    $f"; done
  fi
  (( $#PLAN_DIRS ))   && echo "■ 빈 폴더 정리 (${#PLAN_DIRS}개 중 비어 있는 것만)"
  (( $#PLAN_LABELS )) && echo "■ 서비스 등록 해제: ${(j:, :)PLAN_LABELS}"
  (( $#PLAN_PKGS ))   && echo "■ 설치 기록 삭제: ${#PLAN_PKGS}개 패키지"
  if (( $#PLAN_SKIP )); then
    echo
    echo "■ 남겨 두는 것"
    for f in $PLAN_SKIP; do echo "    $f"; done
  fi
  if (( $#PLAN_ROOTS + $#PLAN_FILES + $#PLAN_LABELS + $#PLAN_PKGS == 0 )); then
    echo "지울 것이 없어요."
    return 1
  fi
}

remove_products() {
  local dry=0 yes=0 args=() a
  for a in "$@"; do
    case $a in
      -n|--dry-run) dry=1 ;;
      -y|--yes)     yes=1 ;;
      *)            args+=($a) ;;
    esac
  done
  if (( ! $#args )); then
    echo "지울 제품을 골라 주세요. 예) banksec remove touchen" >&2
    echo "감지된 제품: ${(j:, :)${(f)"$(products)"}}" >&2
    exit 2
  fi
  select_products $args
  plan_remove $SELECTED
  show_plan || exit 0
  (( dry )) && exit 0

  if (( ! yes )); then
    echo
    printf "위 항목을 삭제할까요? 되돌릴 수 없어요. [y/N] "
    local answer; read -r answer < /dev/tty
    [[ ${answer:l} == y* ]] || { echo "취소했어요."; exit 0 }
  fi
  [[ $EUID -eq 0 ]] || sudo -v || exit 1

  local label t p pids=() f
  for label in $PLAN_LABELS; do
    t=$(target $label)
    if [[ $t == system ]]; then run_root launchctl bootout system/$label 2>/dev/null
    else launchctl bootout $t/$label 2>/dev/null; fi
  done
  for p in $SELECTED; do pids+=($(leftover_pids "($(product_re $p))")); done
  (( $#pids )) && run_root kill $pids 2>/dev/null

  for f in $PLAN_ROOTS; do run_root rm -rf -- $f; done
  for f in $PLAN_FILES; do run_root rm -f -- $f; done
  # 깊은 폴더부터 비었으면 지움
  for f in ${(f)"$(print -rl -- $PLAN_DIRS | awk -F/ '{print NF"\t"$0}' | sort -rn | cut -f2-)"}; do
    run_root rmdir -- $f 2>/dev/null
  done
  for p in $PLAN_PKGS; do run_root pkgutil --forget $p >/dev/null 2>&1; done

  # 꺼둔 기록을 풀어 둬야 나중에 다시 설치했을 때 정상 동작한다
  for label in $PLAN_LABELS; do
    t=$(target $label)
    if [[ $t == system ]]; then run_root launchctl enable system/$label
    else launchctl enable $t/$label; fi
  done
  mkdir -p ${REMOVED_FILE:h} && print -rl -- $REMOVED $PLAN_LABELS | sort -u >| $REMOVED_FILE
  [[ $EUID -eq 0 ]] && chown -R $UID_NUM ${REMOVED_FILE:h} ${REMOVED_FILE:h:h} 2>/dev/null
  rm -f $CACHE_FILE

  echo
  for p in $SELECTED; do echo "🗑  $p 삭제됨"; done
}

# ───────────────────────── 출력 ─────────────────────────

state_text() {
  case $P_STATE in
    on)        echo "켜짐 ($P_RUNNING/$P_TOTAL)" ;;
    off)       echo "꺼짐" ;;
    noservice) echo "상시 실행 없음" ;;
    removed)   echo "삭제됨 (흔적 남음)" ;;
  esac
}

show_status() {
  print -r -- "제품                       명령어에 쓸 이름          상태"
  local p
  for p in ${(f)"$(products)"}; do
    product_state $p
    printf "%-26s %-25s %s\n" "$p" "$(slug $p)" "$(state_text)"
  done
}

# 메뉴바 앱용: 제품 한 줄에 "이름<TAB>slug<TAB>상태<TAB>실행 중<TAB>서비스 수"
show_status_tsv() {
  local p
  for p in ${(f)"$(products)"}; do
    product_state $p
    printf "%s\t%s\t%s\t%s\t%s\n" "$p" "$(slug $p)" "$P_STATE" "$P_RUNNING" "$P_TOTAL"
  done
}

show_list() {
  local p label pkg note
  for p in ${(f)"$(products)"}; do
    product_state $p
    echo "■ $p — $(state_text)"
    for label in ${(f)"$(labels_of $p)"}; do
      note=${PLIST[$label]:-(plist 없음)}
      [[ -f ${PLIST[$label]} ]] && is_orphan $label && note="$note  (실행 파일 없음: ${PROGRAM[$label]})"
      printf "    %-36s %-7s %s\n" "$label" "${DOMAIN[$label]}" "$note"
    done
    local pkgs=(${(f)"$(pkgs_of $p)"})
    if (( $#pkgs > 3 )); then printf "    설치 기록: %s 외 %d개\n" "${pkgs[1]}" $(( $#pkgs - 1 ))
    else for pkg in $pkgs; do printf "    설치 기록: %s\n" "$pkg"; done; fi
  done
  echo
  local pids=($(leftover_pids))
  echo "서비스 밖 잔여 프로세스: ${#pids}개"
  (( $#pids )) && ps -o pid=,comm= -p ${(j:,:)pids}
  echo
  echo "설정 파일: $CONFIG_DIR/{keywords,products,exclude}"
}

usage() {
  cat <<'EOF'
사용법: banksec <명령> [제품...]
  status                 제품별 켜짐/꺼짐 상태
  off [제품...]           끄기 (재부팅 후에도 유지). 제품을 안 고르면 전부
  on  [제품...]           켜기. 제품을 안 고르면 전부
  remove [-n|-y] 제품...  삭제. -n: 지울 목록만 보기, -y: 확인 없이 삭제
  list                   감지된 서비스와 감지 근거

예)  banksec off              전부 끄기
     banksec on touchen       TouchEn nxKey 만 켜기
     banksec remove -n touchen  TouchEn 을 지우면 무엇이 지워지는지 보기
EOF
}

discover
case "$1" in
  on)     shift; turn_on "$@" ;;
  off)    shift; turn_off "$@" ;;
  remove) shift; remove_products "$@" ;;
  status) [[ $2 == --tsv ]] && show_status_tsv || show_status ;;
  list)   show_list ;;
  *)      usage; exit 1 ;;
esac
